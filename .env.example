# Copy to .env and fill in.

# Which model answers: "claude" or "ollama".
#   claude - sends the original PDFs, returns verified quote-level citations.
#   ollama - free, runs on this machine, page-level attribution only.
NDIS_BACKEND=ollama

# --- claude backend -------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model + reasoning effort. Effort is the main quality/cost lever.
# high = safest for health-adjacent guidance; medium = cheaper/faster.
NDIS_MODEL=claude-opus-5
NDIS_EFFORT=high

# Retrieval budget: how much of the corpus goes to the model per question.
NDIS_MAX_DOCS=8
NDIS_MAX_PAGES=300
NDIS_MAX_BYTES=20000000

# --- ollama backend -------------------------------------------------------
NDIS_OLLAMA_HOST=http://127.0.0.1:11434
NDIS_OLLAMA_MODEL=qwen3:8b
# Generation on an integrated GPU takes minutes, not seconds.
NDIS_OLLAMA_TIMEOUT=600
# Reasoning mode. Measured better ON: same speed, tighter answers.
NDIS_OLLAMA_THINK=1
# How long the model stays resident after answering. While the whole corpus
# fits in LOCAL_MAX_PAGES the prompt prefix never changes, so a warm model
# reuses its KV cache and follow-up questions skip prompt processing. Set to
# "0" to unload immediately and reclaim the RAM between questions.
NDIS_OLLAMA_KEEP_ALIVE=30m

# Local context budget. Pages are far cheaper than PDFs but the model must read
# every token before answering, so this is much tighter than MAX_PAGES above.
# If the whole corpus fits in LOCAL_MAX_PAGES it is sent whole and retrieval is
# skipped entirely.
NDIS_LOCAL_MAX_PAGES=24
# Raising the context window costs RAM (KV cache). 16k suits an 8B model in 16 GB.
NDIS_LOCAL_MAX_CTX=16384
NDIS_LOCAL_MAX_OUTPUT=1200

# Tenant this instance serves. Multi-tenant seam - see README.
NDIS_DEFAULT_ORG=default
